HF_TOKEN=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
OPENAI_API_KEY=""
INGESTION_MODEL=hugging-quants/Meta-Llama-3.1-8B-Instruct-AWQ-INT4
# Generation model should be 32B with 128GB RAM. Reduce to 14B for 24GB RAM.
GENERATION_MODEL=Qwen/Qwen3-14B-AWQ
GENERATION_EXTRA_FLAGS="--quantization awq --enable-prefix-caching --reasoning-parser qwen3"
# k=20 for 128GB RAM, reduce to 12 at 24GB
# k nodes * 500 tokens/node < generation context_window = 10,000 tokens
VECTOR_TOP_K=10
GENERATION_MODEL_MAX_LEN=32768